DATABASE_URL="postgresql://medianoche:medianoche@localhost:5433/medianoche?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=3001
FRONTEND_URL="http://localhost:3000"
# Firebase project id (public) — used to verify Google ID tokens
FIREBASE_PROJECT_ID="your-firebase-project-id"
# Public base URL of this API (used to build uploaded image URLs)
BACKEND_PUBLIC_URL="http://localhost:3001"

# Email — order notifications. Leave SMTP_* empty to use an Ethereal test account.
MAIL_FROM="Medianoche <no-reply@medianoche.com>"
ORDER_NOTIFICATION_EMAIL="pedidos@medianoche.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Flat shipping fee in GTQ cents (Q35.00)
SHIPPING_CENTS="3500"

# Auto-seed the initial catalog on startup ONLY if the products table is empty.
# Set to "false" to disable. Admin account can be set for production security:
AUTO_SEED="true"
ADMIN_EMAIL="admin@medianoche.com"
ADMIN_PASSWORD="admin123"
